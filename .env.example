DATABASE_URL="postgresql://USER@localhost:5432/bracketeer?schema=public"
DATABASE_URL_UNPOOLED="postgresql://USER@localhost:5432/bracketeer?schema=public"
AUTH_SECRET="generate with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
# Bootstrap admin created by `npm run db:seed`
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Origin printed into QR codes / share links (defaults to the request host,
# or the Vercel production domain when deployed).
PUBLIC_BASE_URL="https://bracketeer-lichterloh.vercel.app"
